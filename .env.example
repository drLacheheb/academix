# --- API Server Configurations ---
API_SECRET_KEY=your-api-secret-key-here
DATABASE_URL=sqlite:///jobs.db
STALE_CLAIM_TIMEOUT_MINUTES=10
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1
MODELS_DIR=models
HF_HOME=models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# --- Docker Modular Composition ---
# Combine compose files using COMPOSE_FILE environment variable:
# 1. Base (Microservices + SQLite): COMPOSE_FILE=docker-compose.yml
# 2. Base + Local Ollama CPU:       COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml
# 3. Base + Ollama GPU:             COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml:docker-compose.gpu.yml
# 4. Full Production (Ollama GPU + Postgres): COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml:docker-compose.gpu.yml:docker-compose.postgres.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.ollama.yml:docker-compose.gpu.yml

# --- LLM Service (Ollama) Configurations ---
LLM_MODEL=hf.co/unsloth/gemma-4-E2B-it-GGUF:gemma-4-E2B-it-Q3_K_M.gguf
LLM_SERVICE_URL=http://ollama:11434/v1
OLLAMA_CONTEXT_LENGTH=8192

# --- Matching Configurations ---
MATCH_THRESHOLD=0.75
DEGREE_SIMILARITY_THRESHOLD=0.71

# --- Crawling & Sourcing Configurations ---
API_URL=http://localhost:8000
MAX_PAGES=-1
MAX_SAFETY_PAGES=1000
CRAWL_ONCE=false
CRAWL_INTERVAL=3600
SOURCING_INTERVAL=15

# --- General Agent Configurations ---
AGENT_POLL_INTERVAL=10
TEMPERATURE=0.0
MAX_INPUT_TOKENS=8192
MAX_OUTPUT_TOKENS=4096
REFINEMENT_WORKER_REPLICAS=1

# --- Translation Configurations ---
NLLB_MODEL_PATH=mijuanlo/nllb-200-distilled-600M-ct2-int8

# --- Logging Configurations ---
LOG_FILE=agent.log

# --- Storage Configurations ---
STORAGE_PROVIDER=local
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=us-east-1

# --- Telegram Bot Configurations ---
TELEGRAM_BOT_TOKEN=
